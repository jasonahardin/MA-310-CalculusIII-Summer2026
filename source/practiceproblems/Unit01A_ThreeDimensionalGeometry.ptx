<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
  <title>Unit 1A: Three-Dimensional Geometry</title>

 <exercise>
  <introduction>
    <p>
      Describe the set of points represented by the given equation or inequality.
    </p>
  </introduction>
  <task>
    <statement>
      <p>
        <m> z = 5 </m>
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m> y = -3 </m>
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m> x = y </m>
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m> -1 \le z \le 4 </m>
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m> xyz = 0 </m>
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m> x^2 + z^2 = 9 </m>, <m> y = 5 </m>
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m> x^2 + y^2 + z^2 \le 100 </m>
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m> x^2 + y^2 \le 1 </m>, <m> z = 0 </m>
      </p>
    </statement>
  </task>
 </exercise>
 
 <exercise>
  <introduction>
    <p>
      Find the equations or inequalities which describe the following sets of points in <m> \mathbb{R}^3 </m>.
    </p>
  </introduction>
  <task>
    <statement>
      <p>
        The plane through <m>(2,0,-1)</m> that is parallel to the <m>xy</m>-plane.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        The plane through <m>(1,0,0)</m> that is perpendicular to the <m>x</m>-axis.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        The plane through <m>(\ln(3),\sqrt{5},e)</m> that is perpendicular to the <m>z</m>-axis.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        The sphere of radius <m>\sqrt{5}</m> centered at the point <m>(1,2,3)</m>.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        The sphere centered at <m>(-1,4,-3)</m> that is tangent to the <m>xy</m>-plane.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        The sphere with a diameter joining the points <m>(0,-2,5)</m> and <m>(2,4,1)</m>.
      </p>
    </statement>
  </task>
 </exercise>


 <exercise>
  <introduction>
    <p>
      Consider the point <m> P = (1.23, \pi, e^2) </m>.
    </p>
  </introduction>
  <task>
    <statement>
      <p>
        Find the distance from <m> P </m> to each of the three coordinate planes.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        Find the coordinates of the projection of <m> P </m> onto the three coordinate planes.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        Find the projection of the point <m> P </m> on the planes <m> x=1 </m>, <m> y=2 </m>, and <m> z=3 </m>.
      </p>
    </statement>
  </task>
 </exercise>

 <exercise>
  <introduction>
    <p>
      Consider the points <m> P = (-1,2,7) </m>, <m> Q = (1,1,3) </m>, and <m> R = (5,3,2)</m>.
    </p>
  </introduction>
  <task>
    <statement>
      <p>
        Find the exact perimeter of <m> \triangle PQR </m>.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        Is <m> \triangle PQR </m> isosceles? Explain why or why not.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        Find the exact area of <m> \triangle PQR </m>.
      </p>
    </statement>
  </task>
 </exercise>

</worksheet>
