<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
  <title>Unit 1B: Vectors</title>

  <exercise>
    <introduction>
      <p>
        Consider vectors <m> \vec{u} = \langle 4,-1,0\rangle </m> and <m> \vec{v} = \langle 5,8,-2 \rangle</m>. Find the following quantities.
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          <m> 3\vec{u} </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> 2\vec{u} + \vec{v} </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> 4\vec{v} - \vec{u} </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m>\dfrac{1}{4}\vec{u} + \dfrac{3}{4}\vec{v} </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> \vec{u} - \dfrac{1}{2} \vec{v} </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> \dfrac{2}{5} \vec{u} - \pi\vec{v} </m>
        </p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Consider vectors <m> \vec{u} = \langle 3,-1,2 \rangle </m> and <m> \vec{v} = \langle 2,-1,1 \rangle </m>. 
        Find the coordinates of the terminal point of the following vectors.
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          <m> 2\vec{u} </m> with initial point <m> (4,0,-1) </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> -4\vec{v} </m> with initial point <m> (2,5,-3) </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> \vec{u} - 2\vec{v} </m> with initial point <m> (3,7,-10) </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> 5\vec{v} - 3\vec{u} </m> with initial point <m> (-3,6,11) </m>
        </p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Find a vector <m> \vec{v} </m> which solves each equation.
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          <m> 2\vec{v} + \langle 4,-8,2 \rangle = \langle 2,2,2 \rangle </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> \langle 4,-7,1 \rangle - 4\vec{v} = \langle 5,-1,0 \rangle </m>
        </p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        Find the point which is one third of the way from the point <m> P = (12,-3,0) </m> to the point <m> Q = (0,6,-9) </m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        For each vector <m> \vec{v} </m> below, find a unit vector <m> \vec{u} </m> which is pointing in the same direction as <m> \vec{v} </m> 
        and another unit vector which is pointing in the opposite direction of <m> \vec{v} </m>. 
        Give your answers in terms of the standard basis vectors <m> \vec{i} </m>, <m> \vec{j} </m>, and <m> \vec{k} </m>.
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          <m> \vec{v} = \langle -8,6 \rangle </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> \vec{v} = \langle 2,0,-1 \rangle </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> \vec{v} = \left\langle 3, -\dfrac{5}{4}, \dfrac{13}{4} \right\rangle </m>
        </p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        For each pair of points <m> P </m> and <m> Q </m>, write the vector <m> \vec{PQ} </m> as a product of its magnitude and a unit vector.
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          <m> P = (-1,3,4) </m> and <m> Q = (-5,0,4) </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> P = (-2,-1,3) </m> and <m> Q = (1,-4,1) </m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m> P = \left(-5,1,\dfrac{\sqrt{7}}{2}\right) </m> and <m> Q = \left(-1,-\dfrac{1}{2},0\right) </m>
        </p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        Consider the vector <m> \vec{v} = \langle 2,1,-2 \rangle </m>. Find an appropriate scalar <m> a </m> such that the vector <m> a\vec{v} </m> has magnitude <m> 3 </m>.
      </p>
    </statement>
  </exercise>




</worksheet>
